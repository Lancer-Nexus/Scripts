ASPNETCORE_ENVIRONMENT=Production
Agent__NodeId=agent-01
Agent__CoordinatorQuicEndpoint=quic://10.20.0.20:7443
Agent__ClientCertificatePath=/etc/lancer-nexus/certs/agent-01-client.pfx
Agent__ClientCertificatePassword=
Agent__CoordinatorCaCertificatePath=/etc/lancer-nexus/certs/cluster-ca.crt
Agent__InstanceConfigRoot=/etc/lancer-nexus/instances
Agent__ReleaseRoot=/opt/lancer-nexus/releases
Agent__MaximumManagedInstances=32
Agent__DrainTimeoutSeconds=60

# Agent is outbound-only in the current topology; do not open an inbound firewall port.
