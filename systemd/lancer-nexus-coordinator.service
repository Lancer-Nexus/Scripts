[Unit]
Description=Lancer Nexus Coordinator
Documentation=https://github.com/Lancer-Nexus/Coordinator
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
User=lancer
Group=lancer
WorkingDirectory=/opt/lancer-nexus/current/coordinator
ExecStart=/opt/lancer-nexus/current/coordinator/LancerNexus.Coordinator
EnvironmentFile=/etc/lancer-nexus/coordinator.env
StateDirectory=lancer-nexus-coordinator
UMask=0077
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/lancer-nexus-coordinator /var/log/lancer-nexus

[Install]
WantedBy=multi-user.target
