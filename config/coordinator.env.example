ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=https://10.20.0.20:8444
Kestrel__Certificates__Default__Path=/etc/lancer-nexus/certs/coordinator-http-server.pfx
Kestrel__Certificates__Default__Password=

# Protected HTTP APIs stay on the private interface and fail closed until a real secret is supplied.
Coordinator__InternalApiKey=
Coordinator__StateFile=/var/lib/lancer-nexus/coordinator/coordinator-state.json
Coordinator__Registry__AgentHeartbeatTimeoutSeconds=15
Coordinator__Registry__InstanceHeartbeatTimeoutSeconds=15
Coordinator__Placement__MaximumHeartbeatAgeSeconds=15
Coordinator__Placement__ReservationLifetimeSeconds=15
Coordinator__Placement__GroupAffinityLifetimeSeconds=30

# Enable only after installing a server certificate and a client CA certificate.
Coordinator__Quic__Enabled=false
Coordinator__Quic__ListenAddress=10.20.0.20
Coordinator__Quic__Port=7443
Coordinator__Quic__NodeId=coordinator-01
Coordinator__Quic__InstanceId=coordinator-01
Coordinator__Quic__ServerCertificatePath=/etc/lancer-nexus/certs/coordinator-quic-server.pfx
Coordinator__Quic__ServerCertificatePassword=
Coordinator__Quic__ClientCaCertificatePath=/etc/lancer-nexus/certs/cluster-client-ca.crt
Coordinator__Quic__RequiredCapabilities__0=cluster_handshake_v1
