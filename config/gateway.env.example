# Public HTTPS entrypoint. Bind only on the designated Gateway host.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=https://0.0.0.0:443
Kestrel__Certificates__Default__Path=/etc/lancer-nexus/certs/gateway-server.pfx
# Supply the real password through the host's protected secret mechanism; never commit it.
Kestrel__Certificates__Default__Password=

# Private service dependencies; values are examples and must resolve only on the private network.
Gateway__CoordinatorBaseUrl=https://10.20.0.20:8444
Gateway__CoordinatorApiKey=
# Keep connection strings in secret storage; the current Gateway uses the Coordinator URL and API key for placement.
ConnectionStrings__Gateway=
Gateway__RedisEndpoint=127.0.0.1:6379
Gateway__RequestTimeoutSeconds=5
Gateway__LoginRateLimitPerMinute=10
Gateway__PlacementRateLimitPerMinute=30
Gateway__AccessTokenLifetimeMinutes=10
Gateway__AccessTokenKeyId=gateway-key-01
Gateway__AccessTokenAudience=game-server
Gateway__AccessTokenSigningKey=
Gateway__RefreshTokenLifetimeDays=14
Gateway__TrustForwardedHeaders=false
