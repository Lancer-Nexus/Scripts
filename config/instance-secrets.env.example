# Install outside the release tree with root ownership and mode 0600 or 0640.
# LLServer requires the Coordinator API key for globally allocated NPC identities.
LANCER_NEXUS_COORDINATOR_API_KEY=

# Required only when NPC mTLS/QUIC listeners are enabled in LLServer config.
LANCER_NEXUS_NPC_TRANSFER_CERT_PASSWORD=
