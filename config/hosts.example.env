# Example private network only; replace these values per environment.
LN_PRIVATE_CIDR=10.20.0.0/24
LN_GATEWAY_PRIVATE_IP=10.20.0.10
LN_COORDINATOR_PRIVATE_IP=10.20.0.20
LN_AGENT_PRIVATE_IP=10.20.0.31
LN_INSTANCE_PRIVATE_IP=10.20.0.31
LN_PUBLIC_GATEWAY_HOST=gateway.example.net

LN_GATEWAY_HTTPS_PORT=443
LN_COORDINATOR_HTTPS_PORT=8444
