[Unit]
Description=Lancer Nexus LibreLancer instance %i
Documentation=https://github.com/Lancer-Nexus/Client
Wants=network-online.target
After=network-online.target lancer-nexus-agent.service

[Service]
Type=exec
User=lancer
Group=lancer
WorkingDirectory=/var/lib/lancer-nexus/instances/%i
ExecStartPre=/opt/lancer-nexus/current/scripts/bin/ln-validate-instance-config.sh --instance-env /etc/lancer-nexus/instances/%i.env --llserver-config /etc/lancer-nexus/instances/%i.json --agent-env /etc/lancer-nexus/agent.env
ExecStart=/opt/lancer-nexus/current/client/LLServer --config /etc/lancer-nexus/instances/%i.json
ExecStartPost=/opt/lancer-nexus/current/scripts/bin/ln-wait-instance-ready.sh --llserver-config /etc/lancer-nexus/instances/%i.json --timeout 90
EnvironmentFile=/etc/lancer-nexus/instances/%i.env
StateDirectory=lancer-nexus-instance-%i
UMask=0077
Restart=on-failure
RestartSec=5s
TimeoutStopSec=90s
TimeoutStartSec=120s
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/lancer-nexus/instances/%i /var/lib/lancer-nexus-instance-%i /run/lancer-nexus

[Install]
WantedBy=multi-user.target
