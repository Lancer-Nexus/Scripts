# Example firewall allowlist; apply only after verifying host ownership and routes.
LN_PUBLIC_TCP_ALLOWLIST=443
LN_PRIVATE_TCP_ALLOWLIST=8444
LN_PRIVATE_UDP_ALLOWLIST=7443,2300
