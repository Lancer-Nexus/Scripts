ASPNETCORE_ENVIRONMENT=Production
Agent__NodeId=node-01
Agent__AgentId=agent-01
Agent__BuildVersion=1.0.0
Agent__Coordinator__QuicEndpoint=10.20.0.20:7443
Agent__Coordinator__ServerName=coordinator.internal.example
Agent__Coordinator__ClientCertificatePath=/etc/lancer-nexus/certs/agent-01-client.pfx
Agent__Coordinator__ClientCertificatePassword=
Agent__Coordinator__CaCertificatePath=/etc/lancer-nexus/certs/cluster-ca.crt
Agent__Coordinator__HeartbeatIntervalSeconds=5
Agent__Instance__StatusFile=/run/lancer-nexus/liberty-01.status.json
Agent__Instance__InstanceId=liberty-01
Agent__Instance__SystemId=li01
Agent__Instance__Endpoint=10.20.0.31:2300
Agent__Instance__MaxPlayers=200
Agent__Capabilities__0=cluster_handshake_v1
Agent__Capabilities__1=agent_heartbeat_v1
Agent__Capabilities__2=instance_heartbeat_v1
Agent__StateFile=/var/lib/lancer-nexus-agent/heartbeat-sequence.txt

# Agent is outbound-only. Allow only UDP/7443 to the configured Coordinator; do not open an inbound firewall port.
